# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
attached_assets/

# --- Safety: never commit embedded widget repos / backups / build artifacts ---
fractpath-calculator-widget-src/
fractpath-calculator-widget-src__backup_*/
**/fractpath-calculator-widget-src__backup_*/
**/dist/
**/dist-types/
**/.next/
**/.turbo/
attached_assets/

