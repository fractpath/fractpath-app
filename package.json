{
  "name": "fractpath-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sh -lc 'next dev --webpack -H 0.0.0.0 -p ${PORT:-5000}'",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "predev": "node scripts/check-env.mjs",
    "prebuild": "node scripts/check-env.mjs",
    "smoke": "bash scripts/smoke.sh",
    "lint:route-params": "bash scripts/guard-route-params.sh",
    "verify": "npm run lint && npm run build && npm run smoke"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "fractpath-calculator-widget": "git+https://github.com/fractpath/fractpath-calculator-widget.git#v1.0.4",
    "heic2any": "^0.0.4",
    "next": "16.1.6",
    "node-fetch": "^3.3.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "10.4.20",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@10.26.1"
}
